(footprint "SW_Omron_B3U-1000P" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Omron B3U-1000P(M) top-actuated tactile switch 3.0x2.5x1.2mm, no ground terminal, no boss. PCB pattern per Omron datasheet: 0.8x1.7 pads, 4.2 outer, 2.6 inner. Pad 2 left, pad 1 right (Omron numbering). https://omronfs.omron.com/en_US/ecb/products/pdf/en-b3u.pdf")
  (tags "switch tactile Omron B3U")
  (attr smd)
  (fp_text reference "REF**" (at 0 -2.3) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "SW_Omron_B3U-1000P" (at 0 2.3) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer "F.Fab")
    (effects (font (size 0.4 0.4) (thickness 0.06)))
  )
  (fp_line (start -1.5 -1.25) (end 1.5 -1.25) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 1.5 -1.25) (end 1.5 1.25) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start 1.5 1.25) (end -1.5 1.25) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_line (start -1.5 1.25) (end -1.5 -1.25) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_circle (center 0 0) (end 0.75 0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start -1.1 -1.37) (end 1.1 -1.37) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -1.1 1.37) (end 1.1 1.37) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_circle (center 0 0) (end 0.75 0) (stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_line (start -2.35 -1.5) (end 2.35 -1.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 2.35 -1.5) (end 2.35 1.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 2.35 1.5) (end -2.35 1.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -2.35 1.5) (end -2.35 -1.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (pad "2" smd roundrect (at -1.7 0) (size 0.8 1.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
  (pad "1" smd roundrect (at 1.7 0) (size 0.8 1.7) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25))
)
